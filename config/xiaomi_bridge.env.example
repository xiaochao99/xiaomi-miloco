# 小米音箱桥接配置
# Reference: open-xiaoai-bridge configuration

# 启用桥接 (0=禁用, 1=启用)
MILOCO_BRIDGE_ENABLED=1

# ===== VAD (语音活动检测) 配置 =====
# 检测阈值 (0-1, 越小越灵敏)
MILOCO_VAD_THRESHOLD=0.10
# 最小语音时长 (ms)
MILOCO_VAD_MIN_SPEECH=250
# 最小静默时长 (ms)
MILOCO_VAD_MIN_SILENCE=500
# VAD模型路径 (silero_vad.onnx)
MILOCO_VAD_MODEL_PATH=

# ===== KWS (关键词检测) 配置 =====
# 唤醒词列表 (逗号分隔)
MILOCO_WAKEUP_KEYWORDS=小米同学
# 唤醒词置信度加成 (越高越难误触发)
MILOCO_KWS_SCORE=2.0
# 唤醒词检测阈值 (越低越灵敏)
MILOCO_KWS_THRESHOLD=0.2
# KWS模型目录 (sherpa-onnx-kws模型)
MILOCO_KWS_MODEL_DIR=

# ===== ASR (语音识别) 配置 =====
# ASR模型: sense_voice / paraformer / fire_red_asr
MILOCO_ASR_MODEL=sense_voice
# 使用INT8量化模型 (0=禁用, 1=启用)
MILOCO_ASR_INT8=1
# ASR模型目录
MILOCO_ASR_MODEL_DIR=
# ASR推理线程数
MILOCO_ASR_THREADS=2

# ===== TTS (语音合成) 配置 =====
# TTS引擎: doubao / xiaoai
MILOCO_TTS_ENGINE=doubao
# 豆包App ID
MILOCO_DOUBAO_APP_ID=
# 豆包Access Key
MILOCO_DOUBAO_ACCESS_KEY=
# 豆包音色
MILOCO_DOUBAO_VOICE=zh_female_vv_uranus_bigtts
# 音频格式: pcm / mp3
MILOCO_TTS_FORMAT=pcm
# 流式播放 (0=禁用, 1=启用)
MILOCO_TTS_STREAM=1
# 语速 (0.5-2.0)
MILOCO_TTS_SPEED=1.0

# ===== 音频配置 =====
# 采样率
MILOCO_SAMPLE_RATE=16000
# 输入增益 (1.0=不处理)
MILOCO_AUDIO_GAIN=1.0

# ===== 对话配置 =====
# 退出关键词 (逗号分隔)
MILOCO_EXIT_KEYWORDS=退出,结束对话,停止
# 超时时间 (秒)
MILOCO_WAKEUP_TIMEOUT=20

# ===== WebSocket配置 =====
# WebSocket服务器端口
MILOCO_WS_PORT=4399
# WebSocket服务器地址
MILOCO_WS_HOST=0.0.0.0